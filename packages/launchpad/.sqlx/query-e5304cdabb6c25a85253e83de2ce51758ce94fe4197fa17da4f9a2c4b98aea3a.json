  "query": "\nSELECT id,\n       description,\n       tags,\n       state as \"state: _\",\n       remind_at,\n       snooze_minutes,\n       repeat_interval as \"repeat_interval: _\"\nFROM reminders\nWHERE state = 'pending'\nAND remind_at <= current_timestamp\n            ",
