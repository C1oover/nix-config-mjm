  "query": "\nSELECT *\nFROM tasks\nWHERE (\n    completed_at IS NULL OR completed_at > current_timestamp - interval '1 day'\n)\nORDER BY\n    (CASE WHEN completed_at IS NULL THEN 0 ELSE 1 END),\n    (CASE WHEN completed_at IS NULL THEN created_at ELSE completed_at END)\n        ",
