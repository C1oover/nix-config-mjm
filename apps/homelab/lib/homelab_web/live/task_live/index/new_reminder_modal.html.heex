<.modal
  show
  id="new_reminder_modal"
  on_confirm={JS.dispatch("submit", to: "#new_reminder_form")}
  on_cancel={JS.push("cancel_new_reminder")}
>
  <:title>New reminder</:title>

  <.form
    for={@form}
    id="new_reminder_form"
    phx-change="change_new_reminder"
    phx-submit="submit_new_reminder"
    x-on:keydown="if($event.key != 'Escape') { $event.stopPropagation() }"
  >
    <.input field={@form[:description]} label="Description" />
    <.input field={@form[:project]} label="Project" />
    <.input field={@form[:notify_at]} label="Notify at" type="datetime-local" />
    <.input field={@form[:snooze_minutes]} label="Notify frequency (in minutes)" type="number" />
    <.input field={@form[:recurrence_string]} label="Repeat every" />
    <!-- needed for enter to work -->
    <button class="hidden">Save</button>
  </.form>

  <:confirm>Save</:confirm>
  <:cancel>Cancel</:cancel>
</.modal>
