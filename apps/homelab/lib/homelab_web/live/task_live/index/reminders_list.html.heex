<div class="flex flex-col mt-6">
  <h2 class="mb-3 font-medium text-lg">Upcoming reminders</h2>
  <div class="flex flex-row gap-x-2">
    <button
      type="button"
      class="inline-flex items-center gap-x-1.5 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
      phx-click="show_new_reminder"
    >
      <.icon name="hero-plus-circle" class="-ml-0.5 h-5 w-5" /> Add reminder
    </button>
    <div
      id="request-notifications-button"
      class="flex flex-row"
      x-data="{ enabled: false }"
      x-init="$nextTick(() => { enabled = Notification.permission == 'granted' })"
      phx-update="ignore"
    >
      <button
        type="button"
        class="inline-flex items-center gap-x-1.5 rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
        @click="enabled = (await Notification.requestPermission()) == 'granted'"
      >
        <.icon name="hero-bell" class="-mx-0.5 h-5 w-5" x-show="!enabled" />
        <.icon name="hero-bell-slash" class="-mx-0.5 h-5 w-5" x-cloak x-show="enabled" />
      </button>
    </div>
  </div>
  <div class="overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div :if={@reminders == []} class="text-center">
      <.icon
        name="hero-clock"
        class="mx-auto h-12 w-12 text-gray-400 stroke-current"
        aria-hidden="true"
      />
      <h3 class="mt-2 text-sm font-semibold text-gray-900">No reminders</h3>
    </div>
    <div :if={@reminders != []} class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
      <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
        <.table id="reminders" rows={@reminders} row_id={&"reminder-#{&1.id}"}>
          <:col :let={task} label="Project" class="text-gray-500">
            <%= task.project %>
          </:col>
          <:col :let={reminder} label="Description" class="w-full font-medium">
            <%= reminder.description %>
          </:col>
          <:col :let={reminder} class="text-gray-500">
            <.relative_time now={@now} time={reminder.notify_at} />
          </:col>
          <:col :let={reminder}>
            <div
              id={"reminder-#{reminder.id}-button"}
              x-data={"dropdown('reminder-#{reminder.id}-dropdown', {placement: 'bottom-end', modifiers: [{name: 'offset', options: {offset: [0, 8]}}]})"}
              class="inline-block text-left mt-1 -mb-2"
            >
              <div>
                <button
                  type="button"
                  class="flex items-center rounded-full text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-100"
                  id={"reminder-#{reminder.id}-menu-button"}
                  x-bind:aria-expanded="isExpanded()"
                  aria-haspopup="true"
                  @click="toggle()"
                >
                  <span class="sr-only">Open options</span>
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M10 3a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM10 8.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM11.5 15.5a1.5 1.5 0 10-3 0 1.5 1.5 0 003 0z" />
                  </svg>
                </button>
              </div>
            </div>
          </:col>
        </.table>
      </div>
    </div>
  </div>
</div>
