<div class="mb-2 flex">
  <div
    id="new-task-button"
    class="relative inline-flex rounded-md shadow-sm"
    x-data="dropdown('new-task-dropdown', {placement: 'bottom-start', modifiers: [{name: 'offset', options: {offset: [0, 8]}}]})"
    phx-update="ignore"
  >
    <button
      type="button"
      phx-click="show_new_task"
      class="relative inline-flex items-center gap-x-1.5 rounded-l-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white ring-1 ring-inset ring-indigo-700 hover:bg-indigo-500 focus:z-10"
    >
      <.icon name="hero-plus-circle" class="-ml-0.5 h-5 w-5" /> Add task
    </button>
    <div class="relative -ml-px block">
      <button
        type="button"
        class="relative inline-flex items-center rounded-r-md bg-indigo-600 px-2 py-2 text-white ring-1 ring-inset ring-indigo-700 hover:bg-indigo-500 focus:z-10"
        id="new-task-dropdown-button"
        x-bind:aria-expanded="isExpanded()"
        aria-haspopup="true"
        @click="toggle()"
      >
        <span class="sr-only">Open options</span>
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
            clip-rule="evenodd"
          />
        </svg>
      </button>
    </div>
  </div>
  <form class="flex items-baseline ml-4">
    <span class="text-sm text-gray-900 font-semibold">Report:</span>
    <select
      id="report-select"
      name="report"
      class="ml-2 w-[150px] rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm sm:leading-6"
      phx-change="change_report"
    >
      <option :for={value <- ~w(ready next all)} value={value} selected={@report == value}>
        <%= value %>
      </option>
    </select>
  </form>
</div>
