<main class="max-w-3xl mx-auto py-6 sm:px-6 lg:px-8">
  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <.section_header>Deployment</.section_header>
    <.list>
      <:item title="Commit"><.commit_message commit={@deploy.commit} /></:item>
      <:item title="Started at"><%= format_datetime(@deploy.started_at) %></:item>
      <:item :if={@deploy.finished_at != nil} title="Finished at">
        <%= format_datetime(@deploy.finished_at) %>
      </:item>
      <:item title="Duration">
        <%= format_duration(@deploy.finished_at || DateTime.utc_now(), @deploy.started_at) %>
      </:item>
    </.list>
  </div>

  <div :if={not Enum.empty?(@events)} class="bg-white shadow overflow-hidden sm:rounded-lg mt-8">
    <div class="bg-white px-4 py-5 border-b border-gray-200 sm:px-6">
      <div class="-ml-4 -mt-2 flex items-center justify-between flex-wrap sm:flex-nowrap">
        <div class="ml-4 mt-2">
          <h3 class="text-lg leading-6 font-medium text-gray-900">
            Timeline
          </h3>
        </div>
      </div>
    </div>

    <div class="flow-root py-4 px-4 sm:px-6">
      <ul class="-mb-8">
        <li :for={event <- @events} class="group">
          <div class="relative pb-8">
            <span
              class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200 group-last:hidden"
              aria-hidden="true"
            />
            <div class="relative flex space-x-3">
              <div>
                <span class={[
                  "h-8 w-8 rounded-full text-white flex items-center justify-center ring-8 ring-white",
                  icon_style(event)
                ]}>
                  <.event_icon event={event} />
                </span>
              </div>
              <div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
                <div>
                  <p class={["text-sm text-gray-700", if(event.level == :ERROR, do: "font-bold")]}>
                    <%= event.summary %>
                  </p>
                </div>
                <div class="text-right text-sm whitespace-nowrap text-gray-500">
                  <time><%= seconds_since_start(event, @deploy) %>s</time>
                </div>
              </div>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </div>
</main>
